# Copy this file to .env on the VM and fill it in. Never commit .env.

# The VM's static external IP address.
PUBLIC_IP=203.0.113.10

# Caddyfile.http = plain HTTP on the IP (works today, for private testing).
# Caddyfile.https-ip = experimental HTTPS on the IP (see the comments in that file).
CADDYFILE=Caddyfile.http

# Used only by the HTTPS mode, for certificate expiry notices.
ACME_EMAIL=you@example.com

# Generate both secrets on the VM:  openssl rand -base64 48
DB_PASSWORD=change-me
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# The first administrator, created at start-up if it does not exist yet.
APP_ADMIN_EMAIL=you@example.com
APP_ADMIN_PASSWORD=change-me-to-a-strong-password
